OPERATION = "NORMALIZE_SEX_BY_SOURCE"
TOOL = "tametools"
NOTES = "출처별 코드표로 표준 성별 열을 생성했습니다. 원 코드와 출처는 보존했습니다."

[LOG.PARAMS]
rows = 6
mapped_rows = 6
missing_sex_preserved = 0
