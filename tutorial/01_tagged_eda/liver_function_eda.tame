<META>
[INFO]
DESCRIPTION = """간기능 검사 태그 기반 EDA 튜토리얼
AST, ALT, GGT, ALP 4개 항목, 15명 환자, 60개 결과
다양한 SEX 입력 형식과 <NUM> comparator 값 혼재"""
AUTHOR = "tametools tutorial"

[FORMAT]
ABSENT_TOKEN = "<<ABSENT>>"
NULL_TOKEN = "<<NULL>>"
EMPTY_TOKEN = "<<EMPTY>>"

[SETTINGS]
VALIDATE_ERROR = "DELETE"
CRR = "VALUE"

[COLUMN."등록번호"]
TAGS = ["ID", "STR"]

[COLUMN."성별"]
TAGS = ["SEX", "BY", "CATEGORY"]

[COLUMN."나이"]
TAGS = ["AGE", "BY"]

[COLUMN."검사항목명"]
TAGS = ["ITEM", "CATEGORY"]

[COLUMN."보고값"]
TAGS = ["RESULT", "<NUM>"]
UNIT = "U/L"

[COLUMN."진료과"]
TAGS = ["BY", "CATEGORY"]

[WORKS]
DEFAULT = ["VALIDATE", "DESCRIBE", "EDA"]
RI = ["VALIDATE", "REFERENCE_INTERVAL"]

[REFERENCE_INTERVAL]
AGE_BIN_WIDTH = 20
BOOTSTRAP_N = 0
REPORT_PATH = "/tmp/tametools_tutorial01/reference_interval_report.docx"
</META>
