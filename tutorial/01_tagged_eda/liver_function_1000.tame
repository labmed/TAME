<META>
[INFO]
DESCRIPTION = "임상화학 간기능 검사 참고치 분석 튜토리얼 - 200명 x 5항목 1000행, 수집기관 2개소 multicenter"
AUTHOR = "tametools tutorial"

[FORMAT]
ABSENT_TOKEN = "<<ABSENT>>"
NULL_TOKEN = "<<NULL>>"
EMPTY_TOKEN = "<<EMPTY>>"

[SETTINGS]
VALIDATE_ERROR = "DELETE"
CRR = "VALUE"

[COLUMN."등록번호"]
TAGS = ["ID", "STR"]

[COLUMN."성별"]
TAGS = ["SEX", "BY", "CATEGORY"]

[COLUMN."나이"]
TAGS = ["AGE"]

[COLUMN."검사항목명"]
TAGS = ["ITEM", "CATEGORY"]

[COLUMN."보고값"]
TAGS = ["RESULT", "<NUM>"]
UNIT = "U/L (TP: g/dL)"

[COLUMN."수집기관"]
TAGS = ["BY", "CATEGORY"]

[COLUMN."검사기기"]
TAGS = ["CATEGORY"]

[WORKS]
DEFAULT = ["VALIDATE", "DESCRIBE", "EDA"]
RI = ["VALIDATE", "REFERENCE_INTERVAL"]

[REFERENCE_INTERVAL]
AGE_BIN_WIDTH = 20
BOOTSTRAP_N = 0
REPORT_PATH = "reference_interval_report.docx"
</META>
