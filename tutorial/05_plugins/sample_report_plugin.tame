<META>
[INFO]
DESCRIPTION = "External report plugin example: role helper + plugin reuse + chart + docx output"

[SETTINGS]
VALIDATE_ERROR = "REPORT"
CRR = "VALUE"

[PLUGINS]
MODULES = [
  "tutorial.plugin_examples.example_count_plugin",
  "tutorial.plugin_examples.combined_report_plugin",
]

[COMBINED_CHEMISTRY_REPORT]
REPORT_PATH = "/tmp/combined_chemistry_report.docx"
</META>
<DATA>
