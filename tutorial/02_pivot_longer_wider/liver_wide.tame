<META>
[INFO]
DESCRIPTION = """임상화학 간기능 검사 - Wide 형식 (LIS 출력 형태)
환자 1행, 검사항목별 컬럼 구조. PIVOT_LONGER 액션으로 long 형식으로 변환.
200명, AST/ALT/GGT/ALP/TP 각 1컬럼 (ALT: <7 검출하한, GGT: <8 검출하한 포함)"""
AUTHOR = "tametools tutorial"

[FORMAT]
ABSENT_TOKEN = "<<ABSENT>>"
NULL_TOKEN = "<<NULL>>"
EMPTY_TOKEN = "<<EMPTY>>"

[SETTINGS]
VALIDATE_ERROR = "DELETE"
CRR = "VALUE"

# 컬럼별 참조값 (wide 형식에서 각 검사항목 컬럼에 직접 UNIT/REF 설정 가능)
[COLUMN."AST"]
TAGS = ["RESULT", "<NUM>"]
UNIT = "U/L"
REF_LOW = "10"
REF_HIGH = "40"

[COLUMN."ALT"]
TAGS = ["RESULT", "<NUM>"]
UNIT = "U/L"
REF_LOW = "7"
REF_HIGH = "35"

[COLUMN."GGT"]
TAGS = ["RESULT", "<NUM>"]
UNIT = "U/L"
REF_LOW = "8"
REF_HIGH = "50"

[COLUMN."ALP"]
TAGS = ["RESULT", "<NUM>"]
UNIT = "U/L"
REF_LOW = "30"
REF_HIGH = "120"

[COLUMN."TP"]
TAGS = ["RESULT", "<NUM>"]
UNIT = "g/dL"
REF_LOW = "6.0"
REF_HIGH = "8.3"

# ────────────────────────────────────────────
# ACTIONS: 데이터 변환 정의
# ────────────────────────────────────────────
[ACTIONS.PIVOT_RESULTS_LONGER]
TYPE = "PIVOT_LONGER"
# wide → long 변환: 검사 5개 컬럼을 검사항목명+보고값 두 컬럼으로
ID_COLS = ["tag:ID", "tag:SEX", "tag:AGE", "tag:GROUP", "tag:INSTRUMENT"]
COLS = ["tag:RESULT"]
NAMES_TO = "검사항목명"
VALUES_TO = "보고값"
# 변환 후 태그 지정: 항목명 컬럼 → ITEM+CATEGORY, 결과값 컬럼 → RESULT+<NUM>
NAMES_TAGS = ["ITEM", "CATEGORY"]
VALUES_TAGS = ["RESULT", "<NUM>"]

# ACTION_PIPELINES: 여러 액션을 순서대로 실행
[ACTION_PIPELINES.TO_LONG]
ACTIONS = ["PIVOT_RESULTS_LONGER"]
</META>
