<META>
[INFO]
DESCRIPTION = """임상화학 간기능 검사 - Long 형식 (PIVOT_WIDER 액션 예제)
200명 × 5항목 = 1000행. 검사항목명으로 wide 피벗 또는 기관별 집계 시연용.
성별은 이미 male/female 표준화 완료."""
AUTHOR = "tametools tutorial"

[FORMAT]
ABSENT_TOKEN = "<<ABSENT>>"
NULL_TOKEN = "<<NULL>>"
EMPTY_TOKEN = "<<EMPTY>>"

[SETTINGS]
VALIDATE_ERROR = "DELETE"

[COLUMN."보고값"]
TAGS = ["RESULT", "NUM"]
UNIT = "U/L (TP: g/dL)"

[WORKS]
DEFAULT = ["VALIDATE", "DESCRIBE", "EDA"]
RI = ["VALIDATE", "REFERENCE_INTERVAL"]

[REFERENCE_INTERVAL]
AGE_BIN_WIDTH = 20
BOOTSTRAP_N = 0

# ────────────────────────────────────────────
# ACTIONS: long → wide 변환 정의
# ────────────────────────────────────────────

[ACTIONS.WIDE_BY_ITEM]
TYPE    = "PIVOT_WIDER"
# long → wide: 검사항목명의 각 값(AST/ALT/GGT/ALP/TP)이 컬럼이 됨
# 환자 1행, 검사 5컬럼 구조로 복원
ID_COLS = ["tag:ID", "tag:SEX", "tag:AGE", "tag:GROUP"]
NAMES_FROM = "tag:ITEM"
VALUES_FROM = "tag:RESULT"
AGG     = "first"

[ACTIONS.MEAN_BY_INST]
TYPE    = "PIVOT_WIDER"
# long → 기관별 평균 집계: 항목×성별×기관 교차표
# 검사항목명, 성별을 행으로, 수집기관을 컬럼으로 평균 계산
ID_COLS = ["tag:ITEM", "tag:SEX"]
NAMES_FROM = "tag:GROUP"
VALUES_FROM = "tag:RESULT"
AGG     = "mean"

[ACTIONS.MEAN_BY_SEX]
TYPE    = "PIVOT_WIDER"
# long → 성별 평균 교차표: 검사항목별 남/여 평균
ID_COLS = ["tag:ITEM", "tag:GROUP"]
NAMES_FROM = "tag:SEX"
VALUES_FROM = "tag:RESULT"
AGG     = "mean"

# ACTION_PIPELINES: 변환 시나리오
[ACTION_PIPELINES.TO_WIDE]
ACTIONS = ["WIDE_BY_ITEM"]

[ACTION_PIPELINES.INST_COMPARISON]
ACTIONS = ["MEAN_BY_INST"]

[ACTION_PIPELINES.SEX_COMPARISON]
ACTIONS = ["MEAN_BY_SEX"]
</META>
